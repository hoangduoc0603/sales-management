{
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@shared/*": ["shared/*"]
    },
    "strict": true,
    "target": "ES2022",
    "types": ["node", "react", "react-dom"]
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "shared/**/*.ts"]
}
